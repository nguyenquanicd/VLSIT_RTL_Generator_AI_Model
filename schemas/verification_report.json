  "bugs_fixed": [
    {
      "id": "BUG-001",
      "description": "MULDIV deadlock: w_muldiv_start gated by i_stall caused the unit to never start",
      "file": "src/rtl/rv32im_ex_stage.sv",
      "fix": "Changed w_muldiv_start to gate on !w_muldiv_busy instead of !i_stall"
    },
    {
      "id": "BUG-002",
      "description": "Stale I-mem response captured after flush: IF stage lacked pending-cancel mechanism",
      "file": "src/rtl/rv32im_if_stage.sv",
      "fix": "Complete rewrite of IF FSM adding reg_pending_cancel to discard in-flight response after flush"
    },
    {
      "id": "BUG-003",
      "description": "TC-005 SB instruction wrong encoding: 0x00200223 encodes SB x2,4(x0) not SB x2,4(x1)",
      "file": "src/tb/tests/tc_005_store_instructions.sv",
      "fix": "Changed encoding to 0x00208223 (bit15=1 sets rs1[0]=1 → x1)"
    },
    {
      "id": "BUG-004",
      "description": "TC-020 timer IRQ missed: 1-cycle CLINT pulse not latched, lost when no valid MEM instruction",
      "file": "src/rtl/rv32im_csr_file.sv",
      "fix": "Added reg_mtip latch; set on i_irq_timer pulse, cleared when MTI trap taken"
    },
    {
      "id": "BUG-005",
      "description": "TC-021 read_reg_trace(x9) returned handler's ADDI x9,x8,4 instead of post-MRET ADDI x9,x0,99",
      "file": "src/tb/tests/tc_021_mret_behavior.sv",
      "fix": "Changed handler to use x10 as intermediate register so first x9 write is the expected post-MRET value"
    },
    {
      "id": "BUG-006",
      "description": "TC-024 test design: x1 written twice (mtvec setup + ADDI x1,x0,55), trace returned wrong value",
      "file": "src/tb/tests/tc_024_precise_exception_commit.sv",
      "fix": "Changed mtvec setup to use x2 so x1 is only written once by ADDI x1,x0,55"
    }
  ],
