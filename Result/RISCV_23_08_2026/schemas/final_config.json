  "constraints": {
    "C1": {
      "rule": "PR_BOOT_ADDR[1:0] == 2'b00",
      "pass": true,
      "detail": "PR_BOOT_ADDR = 32'h8000_0000 → [1:0] = 2'b00"
    },
    "C2": {
      "rule": "PR_MTVEC_RESET[1:0] == 2'b00",
      "pass": true,
      "detail": "PR_MTVEC_RESET = 32'h0000_0000 → [1:0] = 2'b00"
    },
    "C3": {
      "rule": "PR_IRQ_EN == 1 → PR_CSR_EN == 1",
      "pass": true,
      "detail": "PR_IRQ_EN = 1, PR_CSR_EN = 1"
    },
    "C4": {
      "rule": "PR_MTVEC_VEC_EN == 1 → PR_CSR_EN == 1",
      "pass": true,
      "detail": "PR_MTVEC_VEC_EN = 0 → tiền đề sai, ràng buộc thoả vacuously"
    },
    "C5": {
      "rule": "PR_COUNTER_EN == 1 → PR_CSR_EN == 1",
      "pass": true,
      "detail": "PR_COUNTER_EN = 1, PR_CSR_EN = 1"
    },
    "C6": {
      "rule": "PR_DIV_IMPL == 0",
      "pass": true,
      "detail": "Phase 1 khoá ở 0 (SEQ non-restoring)"
    },
    "C7": {
      "rule": "PR_BUS_OUTSTANDING == 1",
      "pass": true,
      "detail": "Phase 1 khoá ở 1"
    },
    "C8": {
      "rule": "PR_RF_IMPL == 1 → target phải là FPGA",
      "pass": true,
      "detail": "PR_RF_IMPL = 0 → flop array, không phụ thuộc công nghệ target"
    }
  },
