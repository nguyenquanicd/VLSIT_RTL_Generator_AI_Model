# Synthesis script — GF180MCU SS 125C 1.62V (worst case)
read_verilog -sv src/rtl/axi_downscaler_fifo.sv src/rtl/axi_downscaler_width_split.sv src/rtl/axi_downscaler_m_axis_if.sv src/rtl/axi_downscaler_top.sv
hierarchy -check -top axi_downscaler_top
proc
opt -full
memory
opt -full
techmap
opt -fast
dfflibmap -liberty /tools/PDK/GF180/globalfoundries-pdk-libs-gf180mcu_fd_sc_mcu7t5v0/build/synopsys/gf180mcu_fd_sc_mcu7t5v0__ss_125C_1v62_full.lib
abc -liberty /tools/PDK/GF180/globalfoundries-pdk-libs-gf180mcu_fd_sc_mcu7t5v0/build/synopsys/gf180mcu_fd_sc_mcu7t5v0__ss_125C_1v62_full.lib -D 5000
opt_clean -purge
stat -liberty /tools/PDK/GF180/globalfoundries-pdk-libs-gf180mcu_fd_sc_mcu7t5v0/build/synopsys/gf180mcu_fd_sc_mcu7t5v0__ss_125C_1v62_full.lib
write_json src/rtl/synth_gf180_ss.json
