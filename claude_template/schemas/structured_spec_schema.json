{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuredSpec",
  "description": "Output của Phase 1 (spec_parser). Input cho Phase 2 (config_ui).",
  "type": "object",
  "required": ["metadata", "requirements", "parameters"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["ip_name", "spec_revision", "phase", "gate_status"],
      "properties": {
        "ip_name":        { "type": "string", "example": "rv32im_core" },
        "spec_revision":  { "type": "string", "example": "0.2" },
        "phase":          { "type": "integer", "const": 1 },
        "gate_status":    { "type": "string", "enum": ["pending", "approved"] },
        "approved_at":    { "type": ["string", "null"] }
      }
    },

    "requirements": {
      "type": "array",
      "description": "Danh sách requirement tách ra từ spec, mỗi cái có REQ-ID duy nhất.",
      "items": {
        "type": "object",
        "required": ["req_id", "text", "category", "ambiguity_score"],
        "properties": {
          "req_id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$",
            "description": "Mã định danh, dạng REQ-001"
          },
          "text": {
            "type": "string",
            "description": "Nội dung requirement nguyên văn"
          },
          "category": {
            "type": "string",
            "enum": ["functional", "timing", "interface", "constraint"],
            "description": "Phân loại requirement"
          },
          "ambiguity_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Điểm mơ hồ 0.0–1.0. Vượt 0.3 thì đánh dấu cần xem lại."
          },
          "needs_review": {
            "type": "boolean",
            "description": "true nếu ambiguity_score > 0.3"
          },
          "source_section": {
            "type": "string",
            "description": "Mục trong spec gốc, ví dụ '§1.1 F02'"
          },
          "parameters_affected": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tên các parameter điều khiển requirement này, ví dụ ['PR_M_EXT_EN']"
          },
          "feature_id": {
            "type": "string",
            "description": "Feature ID tương ứng, ví dụ 'F02'"
          }
        }
      }
    },

    "parameters": {
      "type": "array",
      "description": "Tham số TOP của IP, trích từ §2.2",
      "items": {
        "type": "object",
        "required": ["name", "type", "default", "valid_range", "description"],
        "properties": {
          "name":          { "type": "string", "description": "Tên parameter, dạng PR_*" },
          "type":          { "type": "string", "description": "Kiểu SV, ví dụ 'bit', 'int unsigned', 'logic [31:0]'" },
          "default":       { "type": "string", "description": "Giá trị default dạng string" },
          "valid_range":   { "type": "string", "description": "Mô tả range hợp lệ" },
          "description":   { "type": "string" },
          "locked":        { "type": "boolean", "description": "true nếu không thể thay đổi trong Phase 1" },
          "req_ids":       { "type": "array", "items": { "type": "string" }, "description": "REQ-IDs bị ảnh hưởng" },
          "feature_ids":   { "type": "array", "items": { "type": "string" }, "description": "Feature IDs bị ảnh hưởng" },
          "constraints":   { "type": "array", "items": { "type": "string" }, "description": "Mã constraint liên quan, ví dụ ['C3']" }
        }
      }
    },

    "style_constraints_source": {
      "type": "string",
      "description": "Đường dẫn file quy tắc RTL, thường là 'rtl_rule.md'"
    },

    "ambiguity_flags": {
      "type": "array",
      "description": "Danh sách REQ-ID cần xem lại (ambiguity_score > 0.3)",
      "items": { "type": "string" }
    }
  }
}
